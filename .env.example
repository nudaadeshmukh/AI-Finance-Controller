# ---------------------------------------------------------------------------
# Environment configuration
#
# EVERY VARIABLE HERE IS OPTIONAL.
# A fresh clone with no .env file runs the full deterministic pipeline over the
# frozen datasets and emits complete results. That is deliberate: the reviewer's
# first run must succeed with zero setup.
#
# Copy to .env and fill in only what you need.  NEVER commit .env.
# ---------------------------------------------------------------------------

# --- LLM hypothesis layer (Phase 6) ---------------------------------------
# Absent  -> the hypothesis stage is skipped and the run completes normally.
# Present -> residual records get one bounded LLM proposal each, all of which
#            still pass through the arithmetic verifier.
GROQ_API_KEY=

# Model used for hypothesis generation on the unmatched residual.
# Default: openai/gpt-oss-20b (served by Groq)
# The task is narrow and structured; the verifier, not the model, establishes
# truth. Escalate only if measurement shows it is necessary.
#
# C-013: the original pin `llama-3.3-70b-versatile` was retired from Groq's
# catalogue between Phase 0 and Phase 6 (the API returns 404 model_not_found).
# If gpt-oss-20b is also gone by the time you read this, the layer degrades
# cleanly to HYPOTHESIS_LAYER_UNAVAILABLE and a fresh clone still runs the full
# deterministic pipeline; set this to any chat model the account can reach
# (e.g. openai/gpt-oss-120b) to exercise the hypothesis stage.
RECON_LLM_MODEL=openai/gpt-oss-20b

# Per-call timeout in seconds. On timeout the record becomes an exception with
# HYPOTHESIS_TIMEOUT. The pipeline never crashes on this.
RECON_LLM_TIMEOUT_S=20


# --- Razorpay live adapter (optional; fixture adapter is the default) ------
# Only needed for `--source razorpay`. The default `--source fixture` reads the
# frozen synthetic datasets in data/ and needs none of this.
#
# VERIFY: whether GET /v1/settlements/recon/combined returns data in test mode,
# and whether test-mode settlements exist without real payment flow. If it does
# not, the live adapter ships as a documented stub and the README says so.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=


# --- Paths -----------------------------------------------------------------
# SQLite database location. Default: data/<run_id>/run.db
RECON_DB_PATH=

# results.json output location. Default: data/<run_id>/results.json
RECON_OUT_PATH=
