# ---------------------------------------------------------------------------
# Secrets - never commit
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# ---------------------------------------------------------------------------
# Generated at runtime
#
# NOTE: data/*/sources/*.json, data/*/answer_key.json and data/*/results.json
# ARE committed on purpose. The frozen datasets and their results must be in the
# repo so the static frontend works from a clean clone and a reviewer sees output
# without running anything. Only the SQLite scratch database is ignored.
# ---------------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
data/*/run.db
data/*/inject.db
data/*/report.html
# Internal sidecar written by `recon run` so `recon report` can re-emit without
# re-running the cascade (learned fee slabs + per-pass timings). Regenerable;
# carries wall-clock ms, so not a committed artifact. results.json IS committed.
data/*/cascade.json

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
env/
ENV/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
frontend/public/data/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Scratch
# ---------------------------------------------------------------------------
scratch/
tmp/
*.log
